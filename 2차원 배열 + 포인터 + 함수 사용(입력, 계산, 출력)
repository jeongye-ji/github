#include <stdio.h>

void input_students(int n, char ids[][20], char names[][20], int scores[][3]) {
    for (int i = 0; i < n; i++) {
        printf("\n[%d번째 학생 정보 입력]\n", i + 1);
        printf("학번: ");
        scanf("%s", *(ids + i));
        printf("성명: ");
        scanf("%s", *(names + i));
        printf("국어 점수: ");
        scanf("%d", *(scores + i) + 0);
        printf("영어 점수: ");
        scanf("%d", *(scores + i) + 1);
        printf("수학 점수: ");
        scanf("%d", *(scores + i) + 2);
    }
}

void calculate_scores(int n, int scores[][3], int totals[], double avgs[], char grades[]) {
    for (int i = 0; i < n; i++) {
        *(totals + i) = *(*(scores + i) + 0) + *(*(scores + i) + 1) + *(*(scores + i) + 2);
        *(avgs + i) = *(totals + i) / 3.0;

        if (*(avgs + i) >= 90) *(grades + i) = 'A';
        else if (*(avgs + i) >= 80) *(grades + i) = 'B';
        else if (*(avgs + i) >= 70) *(grades + i) = 'C';
        else if (*(avgs + i) >= 60) *(grades + i) = 'D';
        else *(grades + i) = 'F';
    }
}

void calculate_ranks(int n, int totals[], int ranks[]) {
    for (int i = 0; i < n; i++) {
        *(ranks + i) = 1;
        for (int j = 0; j < n; j++) {
            if (*(totals + j) > *(totals + i)) {
                (*(ranks + i))++;
            }
        }
    }
}

void print_subject_averages(int n, int scores[][3]) {
    int kor_sum = 0, eng_sum = 0, math_sum = 0;
    for (int i = 0; i < n; i++) {
        kor_sum += *(*(scores + i) + 0);
        eng_sum += *(*(scores + i) + 1);
        math_sum += *(*(scores + i) + 2);
    }
    printf("---------------------------------------------------------------------\n");
    printf("[과목 평균] 국어: %.2f | 영어: %.2f | 수학: %.2f\n",
           (double)kor_sum / n, (double)eng_sum / n, (double)math_sum / n);
}

void print_students(int n, char ids[][20], char names[][20], int scores[][3], int totals[], double avgs[], char grades[], int ranks[]) {
    printf("\n%-10s %-10s %-6s %-6s %-6s %-6s %-8s %-4s %-4s\n",
           "학번", "성명", "국어", "영어", "수학", "총점", "평균", "학점", "석차");
    printf("---------------------------------------------------------------------\n");

    for (int i = 0; i < n; i++) {
        printf("%-10s %-10s %-6d %-6d %-6d %-6d %-8.2f %-4c %-4d\n",
               *(ids + i), *(names + i),
               *(*(scores + i) + 0), *(*(scores + i) + 1), *(*(scores + i) + 2),
               *(totals + i), *(avgs + i), *(grades + i), *(ranks + i));
    }

    print_subject_averages(n, scores);
    printf("---------------------------------------------------------------------\n");
}

int main() {
    int n;

    printf("학생 수를 입력하세요 (최대 30명): ");
    if (scanf("%d", &n) != 1 || n <= 0 || n > 30) {
        printf("유효한 학생 수를 입력하지 않았습니다.\n");
        return 1;
    }

    char ids[n][20];
    char names[n][20];
    int scores[n][3];
    int totals[n];
    double avgs[n];
    char grades[n];
    int ranks[n];

    input_students(n, ids, names, scores);
    calculate_scores(n, scores, totals, avgs, grades);
    calculate_ranks(n, totals, ranks);
    print_students(n, ids, names, scores, totals, avgs, grades, ranks);

    return 0;
}
