#include <stdio.h>

long long factorial_recursive(int n) {
    if (n <= 1) {
        printf("1");
        return 1;
    }
    printf("%d * ", n);
    return (long long)n * factorial_recursive(n - 1);
}

long long factorial_iterative(int n) {
    long long result = 1;
    for (int i = n; i >= 1; i--) {
        printf("%d", i);
        if (i > 1) printf(" * ");
        result *= i;
    }
    return result;
}

int is_overflow_risk(int n) {
    if (n > 20) return 1;
    return 0;
}

void print_line() {
    printf("========================================\n");
}

int main() {
    int num;

    printf("팩토리얼을 계산할 정수 입력: ");
    if (scanf("%d", &num) != 1) {
        printf("올바른 정수가 아닙니다.\n");
        return 1;
    }

    if (num < 0) {
        printf("음수의 팩토리얼은 정의되지 않습니다.\n");
        return 1;
    }

    if (is_overflow_risk(num)) {
        printf("\n[경고] 21 이상의 팩토리얼은 64비트 정수(long long) 범위를 초과합니다.\n");
        return 1;
    }

    print_line();
    printf("[1] 재귀 방식 계산 과정:\n");
    printf("%d! = ", num);
    long long rec_result = factorial_recursive(num);
    printf(" = %lld\n", rec_result);

    print_line();
    printf("[2] 반복문 방식 계산 과정:\n");
    printf("%d! = ", num);
    long long iter_result = factorial_iterative(num);
    printf(" = %lld\n", iter_result);

    print_line();
    return 0;
}
