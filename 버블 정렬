#include <stdio.h>

void printArray(int arr[], int n) {
    printf("[ ");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("]\n");
}

void bubbleSort(int arr[], int n, int isAscending) {
    for (int i = 0; i < n - 1; i++) {
        int swapped = 0;
        printf("\n--- Pass %d ---\n", i + 1);

        for (int j = 0; j < n - i - 1; j++) {
            int condition = isAscending ? (arr[j] > arr[j + 1]) : (arr[j] < arr[j + 1]);

            if (condition) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
                swapped = 1;
            }

            printf("  비교 (%d vs %d) -> ", arr[j], arr[j + 1]);
            printArray(arr, n);
        }

        if (!swapped) {
            printf("이미 정렬이 완료되어 조기 종료합니다.\n");
            break;
        }
    }
}

int main() {
    int arr[10];
    int n, option;

    printf("입력할 원소 개수(최대 10개): ");
    if (scanf("%d", &n) != 1 || n <= 0 || n > 10) {
        printf("올바른 개수를 입력하세요.\n");
        return 1;
    }

    printf("%d개의 정수 입력: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("정렬 방식 선택 (1: 오름차순, 2: 내림차순): ");
    scanf("%d", &option);

    printf("\n원래 배열: ");
    printArray(arr, n);

    bubbleSort(arr, n, option == 1);

    printf("\n최종 정렬 결과: ");
    printArray(arr, n);

    return 0;
}
