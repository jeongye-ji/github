#include <stdio.h>

void printArray(int arr[], int n) {
    printf("[ ");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("]\n");
}

void selectionSort(int arr[], int n, int isAscending) {
    for (int i = 0; i < n - 1; i++) {
        int targetIndex = i;
        
        for (int j = i + 1; j < n; j++) {
            int condition = isAscending ? (arr[j] < arr[targetIndex]) : (arr[j] > arr[targetIndex]);
            if (condition) {
                targetIndex = j;
            }
        }

        if (targetIndex != i) {
            int temp = arr[i];
            arr[i] = arr[targetIndex];
            arr[targetIndex] = temp;
        }

        printf("Pass %d (인덱스 %d에 %d 확정) -> ", i + 1, i, arr[i]);
        printArray(arr, n);
    }
}

int main() {
    int arr[10];
    int n, option;

    printf("입력할 원소 개수(최대 10개): ");
    if (scanf("%d", &n) != 1 || n <= 0 || n > 10) {
        printf("올바른 개수를 입력하세요.\n");
        return 1;
    }

    printf("%d개의 정수 입력: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("정렬 방식 선택 (1: 오름차순, 2: 내림차순): ");
    scanf("%d", &option);

    printf("\n원래 배열: ");
    printArray(arr, n);
    printf("\n--- 정렬 과정 ---\n");

    selectionSort(arr, n, option == 1);

    printf("\n최종 정렬 결과: ");
    printArray(arr, n);

    return 0;
}
