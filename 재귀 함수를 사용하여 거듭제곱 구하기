#include <stdio.h>
#include <stdbool.h>

// 1. 단순 재귀 방식
long long power_recursive(int base, int exponent) {
    if (exponent == 0) {
        return 1;
    }
    return (long long)base * power_recursive(base, exponent - 1);
}

// 2. 반복문(Loop) 방식
long long power_iterative(int base, int exponent) {
    long long result = 1;
    for (int i = 0; i < exponent; i++) {
        result *= base;
    }
    return result;
}

// 3. 분할 정복(Divide and Conquer) 방식
long long power_fast(int base, int exponent) {
    if (exponent == 0) {
        return 1;
    }
    
    // 지수를 반으로 나누어 계산
    long long half = power_fast(base, exponent / 2);
    
    if (exponent % 2 == 0) {
        return half * half;           
    } else {
        return half * half * base;     
    }
}

// 4. 실수형 계산 함수
double power_double(double base, int exponent) {
    if (exponent == 0) {
        return 1.0;
    }
    
    if (exponent < 0) {
        return 1.0 / power_double(base, -exponent);
    }
    
    return base * power_double(base, exponent - 1);
}

// 사용자로부터 올바른 입력값을 받는 함수
bool get_input(int *base, int *exponent) {
    printf("밑(base)과 지수(exponent)를 입력하세요 (예: 2 10 또는 2 -3): ");
    if (scanf("%d %d", base, exponent) != 2) {
        printf("[오류] 올바른 정수를 입력하지 않았습니다.\n");
        return false;
    }
    return true;
}

int main() {
    int base, exponent;

    // 입력 검증
    if (!get_input(&base, &exponent)) {
        return 1;
    }

    printf("\n=== 계산 결과 ===\n");

    // 0의 0승 예외 처리
    if (base == 0 && exponent == 0) {
        printf("0의 0승은 수학적으로 정의되지 않습니다 (일반적으로 1로 취급되기도 함).\n");
    }

    // 지수가 양수인 경우 결과 출력
    if (exponent >= 0) {
        printf("[단순 재귀]    %d^%d = %lld\n", base, exponent, power_recursive(base, exponent));
        printf("[반복문 방식]  %d^%d = %lld\n", base, exponent, power_iterative(base, exponent));
        printf("[분할 정복]    %d^%d = %lld\n", base, exponent, power_fast(base, exponent));
    } else {
        printf("[안내] 지수가 음수이므로 정수형 재귀 연산(long long)은 생략합니다.\n");
    }

    // 실수형 계산 결과 출력
    printf("[실수형 결과]  %d^%d = %.6f\n", base, exponent, power_double(base, exponent));

    return 0;
}
